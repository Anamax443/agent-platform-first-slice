# Vzor pro .env (ten je v .gitignore). Zkopíruj na .env a doplň hodnoty; nikdy je necommituj.
# Cloudflare Access service token pro harness proti farmě (Zero Trust -> Access controls -> Service credentials, token "apf-harness").
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Gateway farmy bez https:// (channels.apiHost instalace). Prázdné = testy jen in-process.
APF_BASE_URL=
