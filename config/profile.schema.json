{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "installation-profile.v1",
  "title": "Installation profile v1",
  "description": "Everything bound to one customer or environment, kept out of the code: identities and their scopes, tenants, channels, retention, and which platform policies must exist. Secrets appear only by reference name. Loaded fail-closed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["installation", "tenants", "identities", "roles", "credentials", "channels", "retentionDays", "policyRefs"],
  "properties": {
    "installation": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "description": { "type": "string", "maxLength": 500 },
    "tenants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actorId", "actorType", "tenantId", "scopes", "authStrength"],
        "properties": {
          "actorId": { "$ref": "#/$defs/id" },
          "actorType": { "type": "string", "enum": ["human", "ai-agent", "deterministic-module", "executor", "endpoint-agent", "service", "scheduler"] },
          "tenantId": { "$ref": "#/$defs/id" },
          "scopes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capabilityName" } },
          "authStrength": { "type": "string", "enum": ["oidc-user", "client-credentials", "certificate", "session", "mtls"] }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator"],
      "properties": {
        "orchestrator": { "$ref": "#/$defs/id", "description": "actorId the orchestrators dispatch as." }
      }
    },
    "credentials": {
      "type": "object",
      "description": "handlerId -> credential references that handler may resolve. Values never live here (SecretsSource).",
      "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^cred:[a-z][a-z0-9-]*$" } }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiHost", "intakeAddress", "notifyFrom"],
      "properties": {
        "apiHost": { "type": ["string", "null"], "description": "Gateway host behind Access, e.g. apf.example.org; null = in-process only." },
        "intakeAddress": { "type": ["string", "null"], "description": "Email Routing address delivered to mail.ingest; null = no inbound mail." },
        "notifyFrom": { "type": ["string", "null"], "description": "Sender address of email.send; null = sandbox only." },
        "notifyFromName": { "type": "string", "maxLength": 100 }
      }
    },
    "retentionDays": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originals", "journal", "audit"],
      "properties": {
        "originals": { "type": "integer", "minimum": 1 },
        "journal": { "type": "integer", "minimum": 1 },
        "audit": { "type": "integer", "minimum": 1 }
      }
    },
    "policyRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityName" },
      "description": "Capabilities that MUST have a policy in policy/*.json of this installation (fail-closed at load)."
    },
    "models": {
      "type": "object",
      "description": "AI models per capability: the options the operator may pick from and the default. Never without a model; credentials by reference only; processor and inference geography written down per option (NIS2 / ISO 27001 supplier control).",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["default", "options"],
        "properties": {
          "default": { "type": "string", "minLength": 1 },
          "options": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "model"],
              "properties": {
                "provider": { "type": "string", "enum": ["workers-ai", "anthropic", "fake"] },
                "model": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "maxLength": 100 },
                "credential": { "type": "string", "pattern": "^cred:[a-z][a-z0-9-]*$" },
                "inferenceGeo": { "type": "string", "pattern": "^[a-z]{2,8}$" },
                "processor": { "type": "string", "maxLength": 300 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]*$" },
    "capabilityName": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+(\\.\\*)?$" }
  }
}
