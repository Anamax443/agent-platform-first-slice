{
  "name": "agent-platform-first-slice",
  "version": "0.1.0",
  "private": true,
  "description": "First reference implementation of agent-platform-foundation v1.0-rc2.1: document.classify (AI) -> document.validate (deterministic) -> document.stamp (write executor).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "arch": "node scripts/arch-dep.mjs",
    "farm:check": "node scripts/farm-check.mjs && tsc -p deploy/cloudflare/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@cfworker/json-schema": "^4.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.0"
  }
}
